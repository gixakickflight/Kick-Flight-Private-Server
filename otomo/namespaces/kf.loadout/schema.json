{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kick-Flight loadout, schema version 1",
  "description": "One player's loadout as otomo's session service stores it: the three disc decks, which of them is active, the gear on each kicker costume, and a gear roll not yet equipped. The ids are enumerated from the game's masters, so a deck slot can only name a disc the game ships and a gear slot only a gear it ships; regenerate with gen_schema.py when the masters change. Session adds \"revision\" to every document it stores and strip it before validating, so it is declared here for completeness rather than because a save must carry it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decks",
    "active_deck",
    "costume_gears"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Which schema this document follows. Session picks the schema to check a document by this member and refuses a version it has no rules for."
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "description": "How many times this loadout has been saved; 0 or absent means never. Session owns this member: it writes the stored value into every document it returns and ignores whatever a save carries, because a save names the revision it read in If-Match."
    },
    "decks": {
      "type": "object",
      "description": "Exactly the deck numbers the master defines, each holding one deck of 4 discs in slot order. Keyed by deck number because that is how the adapter's save already holds them (Dictionary<int, List<int>>).",
      "additionalProperties": false,
      "required": [
        "1",
        "2",
        "3"
      ],
      "properties": {
        "1": {
          "$ref": "#/$defs/deck"
        },
        "2": {
          "$ref": "#/$defs/deck"
        },
        "3": {
          "$ref": "#/$defs/deck"
        }
      }
    },
    "active_deck": {
      "description": "The deck a match launches with. Required rather than defaulted: which deck plays is the player's choice, so a document that does not say must not be guessed at.",
      "enum": [
        1,
        2,
        3
      ]
    },
    "costume_gears": {
      "type": "object",
      "description": "The gear equipped on a kicker costume, keyed by the KickerCostume row id (2|kicker|costume|variant, e.g. 2010101). Only costumes the player has equipped something on need an entry; a costume with no entry has three empty slots.",
