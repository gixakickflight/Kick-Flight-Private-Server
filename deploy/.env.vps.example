# Copy this file to .env in the application root and fill both required values.
# KF_PUBLIC_HOST is a bare public IPv4 address or DNS name, without scheme or port.
KF_PUBLIC_HOST=
# Generate each value with: openssl rand -hex 32
KF_DB_PASSWORD=
KF_PG_SUPERUSER_PASSWORD=
# Only the guarded rollback sets this to external; omit or keep local for normal operation.
KF_DB_MODE=local

# HTTP port is configurable because the client builds its CDN URL from the incoming Host header.
# gRPC stays on TCP 18081 because matchmaking advertises that port to clients.
KF_HTTP_PORT=18080

# Optional absolute path to a directory containing octo_sorted/ and generated cdn/. Relative paths resolve
# from deploy/. Defaults to the sibling Kick-Flight-Assets directory expected by the catalog source paths.
KF_ASSETS_PATH=../../Kick-Flight-Assets

# Optional: translate in-game chat (docs/CHAT_TRANSLATION.md). Create a Gemini API key at
# https://aistudio.google.com/apikey and restrict it to "Gemini API" only. Empty = feature off.
# Chat text is sent to Google when set.
GEMINI_API_KEY=
KF_CHAT_TRANSLATE_MODEL=gemini-3.5-flash-lite
KF_CHAT_TRANSLATE_CONTEXT_MESSAGES=20
