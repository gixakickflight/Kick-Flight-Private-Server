# Host values for deploy/docker-compose.nas.yml. Copy to deploy/.env beside the compose file on the host
# ($KF_ROOT/app/deploy/.env), chmod 600, and fill in the host's values. The real file exists only on the host.
#
# Compose reads it for ${...} interpolation and passes it to the api service as an env_file, so the
# Harness__DirectClientHosts__N entries below reach the API as configuration.

# Host layout: $KF_ROOT/{app,assets,pgdata}. Keys (*.key, 0600) live in KF_KEYS_DIR.
KF_ROOT=/mnt/<pool>/kickflight
KF_KEYS_DIR=/mnt/<pool>/kickflight/app/deploy

# The address clients reach this stack on. Luxon advertises it, the API hands it out as the Photon host.
KF_PUBLIC_HOST=<tailnet-or-public-ip>

# The otomo instance, on the Incus bridge (ports as its compose publishes them). Gateway = player plane; the rest are internal listeners published on the bridge.
KF_OTOMO_GATEWAY_URL=http://<otomo-bridge-ip>:18091
KF_OTOMO_CONFIG_URL=http://<otomo-bridge-ip>:18093
KF_OTOMO_ECONOMY_URL=http://<otomo-bridge-ip>:18094
KF_OTOMO_SESSION_URL=http://<otomo-bridge-ip>:18095
KF_OTOMO_CHAT_URL=http://<otomo-bridge-ip>:18096
KF_OTOMO_PATCH_URL=http://<otomo-bridge-ip>:18097
# ops' internal listener: the update gate snapshot, read with ops_game_server.key.
KF_OTOMO_OPS_URL=http://<otomo-bridge-ip>:18098
KF_OTOMO_MASTERS_CHANNEL=staging

# Experimental Scramble AI roles (ExperimentalAiRoleService). The VPS runs 1; the NAS has run without it.
KF_EXPERIMENTAL_AI_ROLES=0

# Optional. Unset keeps the compose default; the database is not published outside the compose network.
#KF_DB_PASSWORD=

# Host gate (Program.cs answers 421 to any other Host). Bare hostnames; the port is stripped before comparison.
Harness__DirectClientHosts__0=<KF_PUBLIC_HOST>
Harness__DirectClientHosts__1=<lan-ip>
Harness__DirectClientHosts__2=<ddns-name>
