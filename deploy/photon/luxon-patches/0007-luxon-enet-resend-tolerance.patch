From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tanuki <t@x>
Date: Mon, 21 Sep 2026 10:50:50 +0000
Subject: [PATCH] enet: ENet-default resend tolerance (32 resends / 30 s)
 instead of 7 / 10 s

Rebased onto 5401810: only the context changed (the incoming reliable
stall settings now sit between disconnect_timeout_ms and max_resends).
This governs the server's own outgoing reliable resends; 5401810 governs
incoming out-of-window drops, so the two do not overlap.
---
 include/luxon/enet_peer.hpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/include/luxon/enet_peer.hpp b/include/luxon/enet_peer.hpp
index 9974e29..86d0c79 100644
--- a/include/luxon/enet_peer.hpp
+++ b/include/luxon/enet_peer.hpp
@@ -61,7 +61,7 @@ struct EnetPeerConfig {
 
     // Approximate measured values
     int time_ping_interval_ms = 1000;
-    int disconnect_timeout_ms = 10000;
+    int disconnect_timeout_ms = 30000;
 
     // Disconnect a peer whose reliable receive window keeps rejecting packets
     // without making progress. The quiet interval prevents a single old drop
@@ -69,7 +69,7 @@ struct EnetPeerConfig {
     int incoming_reliable_stall_timeout_ms = 20000;
     int incoming_reliable_stall_quiet_ms = 5000;
 
-    uint8_t max_resends = 7; // Allows about 20 seconds of resends
+    uint8_t max_resends = 32; // ENet default; 7 dropped Kick-Flight masters on short server->client loss bursts (2026-09-21)
     uint8_t fast_resend_count = 0;
     int max_pending_unreliable_commands = 0;
 
-- 
2.43.0

