    "1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Kick-Flight loadout, version 1",
      "type": "object",
      "required": [
        "schema_version",
        "decks",
        "costume_gears",
        "active_deck"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "decks": {
          "type": "object",
          "description": "Deck number (\"1\" to \"16\") -> the disc ids in it, in slot order. The client uses five decks.",
          "maxProperties": 16,
          "propertyNames": {
            "type": "string",
            "pattern": "^([1-9]|1[0-6])$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "maxItems": 8,
            "uniqueItems": true
          }
        },
        "costume_gears": {
          "type": "object",
          "description": "Costume row id -> its three gear slots (0 = empty), the shape the client reads back as gearId1..3.",
          "maxProperties": 256,
          "propertyNames": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,9}$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "active_deck": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "description": "The deck number the player fights with; it must be a key of decks (the allOf below)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "active_deck": {
                "const": 1
              }
            },
            "required": [
              "active_deck"
            ]
          },
          "then": {
            "properties": {
              "decks": {
                "required": [
                  "1"
                ]
              }
            }
          }
        },
        {
