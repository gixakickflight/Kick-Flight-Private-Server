<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <!-- Player state. Used directly rather than through EF Core: the store interface is deliberately
         synchronous, matching the request handlers that call it, and Npgsql has first-class sync methods. -->
    <PackageReference Include="Npgsql" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos/openmatch.proto" GrpcServices="Server" />
  </ItemGroup>
  <ItemGroup>
    <None Update="catalog-ios-12346.json;boot-index-ios-platform-2.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\config\bot_ai_profiles.json" Link="config\bot_ai_profiles.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\config\bot_ai_profiles.schema.json" Link="config\bot_ai_profiles.schema.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
