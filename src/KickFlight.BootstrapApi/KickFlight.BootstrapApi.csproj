<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <!-- Player state. Used directly rather than through EF Core: the store interface is deliberately
         synchronous, matching the request handlers that call it, and Npgsql has first-class sync methods. -->
    <PackageReference Include="Npgsql" Version="8.0.5" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos/openmatch.proto" GrpcServices="Server" />
  </ItemGroup>
  <ItemGroup>
    <!-- The suite derives otomo device ids the same way the adapter does, so it can count logins per device. -->
    <InternalsVisibleTo Include="KickFlight.BootstrapApi.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Update="catalog-ios-12346.json;boot-index-ios-platform-2.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
